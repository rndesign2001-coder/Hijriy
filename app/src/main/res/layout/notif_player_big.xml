<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pl_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/pl_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
    <ImageView
        android:id="@+id/pl_cover"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/pl_cover"
        android:importantForAccessibility="no"
        android:padding="5dp"
        android:src="@drawable/ic3d_quran" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
        <TextView
            android:id="@+id/pl_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Fotiha — 1-oyat"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/pl_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Mishari Rashid"
            android:textColor="#F3D57E"
            android:textSize="13sp" />
            <TextView
                android:id="@+id/pl_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qur'oni Karim"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    <ImageView
        android:id="@+id/pl_close"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/pl_btn_ghost"
        android:contentDescription="Yopish"
        android:padding="7dp"
        android:src="@drawable/ic_pl_close" />
    </LinearLayout>
        <ProgressBar
            android:id="@+id/pl_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="30"
            android:progressDrawable="@drawable/pl_progress" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">
    <ImageView
        android:id="@+id/pl_prev"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="0dp"
        android:background="@drawable/pl_btn_ghost"
        android:contentDescription="Oldingi"
        android:padding="10dp"
        android:tint="#FFFFFF"
        android:src="@drawable/ic_pl_prev" />
    <ImageView
        android:id="@+id/pl_play"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="22dp"
        android:background="@drawable/pl_btn_gold"
        android:contentDescription="Ijro"
        android:padding="14dp"
        android:tint="#0B3D2E"
        android:src="@drawable/ic_pl_pause" />
    <ImageView
        android:id="@+id/pl_next"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="22dp"
        android:background="@drawable/pl_btn_ghost"
        android:contentDescription="Keyingi"
        android:padding="10dp"
        android:tint="#FFFFFF"
        android:src="@drawable/ic_pl_next" />
    </LinearLayout>
</LinearLayout>
